@model WebApplicationApp.Models.SalesReportPrintModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Sales Report Summary</title>
    <style>
            @@font-face {
                font-family: 'Kalpurush';
                src: local('Kalpurush'), local('Noto Sans Bengali');
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 13px;
                color: #000;
                margin: 25px 30px;
            }

            .report-title {
                text-align: center;
                font-size: 20px;
                font-weight: bold;
                margin-bottom: 4px;
            }

            .criteria {
                text-align: center;
                font-size: 12px;
                margin-bottom: 10px;
            }

            .print-date {
                text-align: left;
                font-size: 12px;
                margin-bottom: 14px;
            }

            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }

            th, td {
                border: 1px solid #999;
                padding: 6px 8px;
            }

            thead th {
                background-color: #e6e6e6;
                font-weight: bold;
                text-align: center;
            }

            td.num {
                text-align: right;
            }

            td.center {
                text-align: center;
            }

            tbody tr:nth-child(even) {
                background-color: #fafafa;
            }

            .total-row td {
                font-weight: bold;
                background-color: #f0f0f0;
            }

            .in-word {
                margin-top: 14px;
                font-size: 13px;
            }

            .in-word-bn {
                margin-top: 4px;
                font-size: 13px;
                font-family: 'Kalpurush', 'Noto Sans Bengali', 'Nirmala UI', sans-serif;
            }

            .footer-note {
                margin-top: 20px;
                text-align: center;
                font-size: 11px;
                color: #555;
            }

            @@media print {
                .no-print {
                    display: none;
                }

                body {
                    margin: 10px 15px;
                }
            }

            .toolbar {
                text-align: right;
                margin-bottom: 12px;
            }

                .toolbar button {
                    padding: 6px 14px;
                    font-size: 13px;
                    cursor: pointer;
                }
    </style>
</head>
<body>

    <div class="toolbar no-print">

        <h6>Print Date: @Model.PrintDate</h6>
    </div>

    <div class="report-title">Sales Report Summary</div>
    <div class="criteria">@Model.CriteriaText</div>
    @* <div class="print-date">Print Date: @Model.PrintDate</div> *@

    <table>
        <thead>
            <tr>
                <th style="width:60px;">SL</th>
                <th>Sales Man Name</th>
                <th style="width:150px;">Sales Quantity</th>
                <th style="width:150px;">Sales Value</th>
            </tr>
        </thead>
        <tbody>
            @{
                int sl = 1;
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td class="center">@sl</td>
                    <td>@(item.SalesManName ?? "Unknown")</td>
                    <td class="num">@((item.SalesQuantity ?? 0).ToString("0.00"))</td>
                    <td class="num">@((item.SalesValue ?? 0).ToString("0.00"))</td>
                </tr>
                sl++;
            }
            <tr class="total-row">
                <td colspan="2">Total Summary</td>
                <td class="num">@Model.TotalQuantity?.ToString("0.00")</td>
                <td class="num">@Model.TotalValue?.ToString("0.00")</td>
            </tr>
        </tbody>
    </table>

    <div class="in-word">In Word: @Model.AmountInWordsEnglish?</div>
    <div class="in-word-bn">কথায়: @Model.AmountInWordsBangla?</div>

    <div class="footer-note">Page 1 of 1</div>

</body>
</html>