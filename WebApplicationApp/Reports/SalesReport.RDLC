  <Code>Public Function NumberToWords(ByVal amount As Decimal) As String
    Dim taka As Long = Math.Floor(amount)
    Dim paisa As Integer = CInt(Math.Round((amount - taka) * 100))

    ' Handle rounding to 100 paisa
    If paisa = 100 Then
        taka += 1
        paisa = 0
    End If

    Dim result As String = ""

    If taka = 0 Then
        result = "Zero Taka"
    Else
        result = ConvertIndianNumberToWords(taka) &amp; " Taka"
    End If

    If paisa &gt; 0 Then
        result &amp;= " and " &amp; ConvertTwoDigitNumberToWords(paisa) &amp; " Paisa"
    End If

    Return result
End Function


Private Function ConvertIndianNumberToWords(ByVal number As Long) As String
    If number = 0 Then
        Return "Zero"
    End If

    Dim result As String = ""

    ' Crore
    If number &gt;= 10000000 Then
        result &amp;= ConvertIndianNumberToWords(number \ 10000000) &amp; " Crore "
        number = number Mod 10000000
    End If

    ' Lakh
    If number &gt;= 100000 Then
        result &amp;= ConvertTwoDigitNumberToWords(number \ 100000) &amp; " Lakh "
        number = number Mod 100000
    End If

    ' Thousand
    If number &gt;= 1000 Then
        result &amp;= ConvertTwoDigitNumberToWords(number \ 1000) &amp; " Thousand "
        number = number Mod 1000
    End If

    ' Hundred
    If number &gt;= 100 Then
        result &amp;= ConvertTwoDigitNumberToWords(number \ 100) &amp; " Hundred "
        number = number Mod 100
    End If

    ' Remaining
    If number &gt; 0 Then
        result &amp;= ConvertTwoDigitNumberToWords(number)
    End If

    Return result.Trim()
End Function


Private Function ConvertTwoDigitNumberToWords(ByVal number As Long) As String

    Dim ones() As String = {
        "", "One", "Two", "Three", "Four",
        "Five", "Six", "Seven", "Eight", "Nine",
        "Ten", "Eleven", "Twelve", "Thirteen",
        "Fourteen", "Fifteen", "Sixteen",
        "Seventeen", "Eighteen", "Nineteen"
    }

    Dim tens() As String = {
        "", "", "Twenty", "Thirty", "Forty",
        "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"
    }

    If number &lt; 20 Then
        Return ones(number)
    End If

    Dim result As String = tens(number \ 10)

    If number Mod 10 &gt; 0 Then
        result &amp;= " " &amp; ones(number Mod 10)
    End If

    Return result
End Function




Public Function NumberToWordsBangla(ByVal amount As Decimal) As String

    Dim taka As Long = Math.Floor(amount)
    Dim paisa As Integer = CInt(Math.Round((amount - taka) * 100))

    ' Handle 100 paisa rounding
    If paisa = 100 Then
        taka += 1
        paisa = 0
    End If

    Dim result As String = ""

    ' Taka
    If taka = 0 Then
        result = "শূন্য টাকা"
    Else
        result = ConvertBanglaNumber(taka) &amp; " টাকা"
    End If

    ' Paisa
    If paisa &gt; 0 Then
        result &amp;= " " &amp; ConvertBanglaNumber(paisa) &amp; " পয়সা"
    End If

    Return result.Trim()

End Function


Private Function ConvertBanglaNumber(ByVal number As Long) As String

    If number = 0 Then
        Return "শূন্য"
    End If

    Dim result As String = ""

    ' কোটি
    If number &gt;= 10000000 Then
        result &amp;= ConvertBanglaNumber(number \ 10000000) &amp; " কোটি "
        number = number Mod 10000000
    End If

    ' লক্ষ
    If number &gt;= 100000 Then
        result &amp;= ConvertBanglaNumber(number \ 100000) &amp; " লক্ষ "
        number = number Mod 100000
    End If

    ' হাজার
    If number &gt;= 1000 Then
        result &amp;= ConvertBanglaNumber(number \ 1000) &amp; " হাজার "
        number = number Mod 1000
    End If

    ' শত
    If number &gt;= 100 Then
        result &amp;= ConvertBanglaNumber(number \ 100) &amp; " শত "
        number = number Mod 100
    End If

    ' বাকি অংশ
    If number &gt; 0 Then
        result &amp;= ConvertBanglaTwoDigit(number)
    End If

    Return result.Trim()

End Function


